# ═══════════════════════════════════════════════════════════
# EaMRD-CRCV 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ═══════════════════════════════════════════════════════════

# ── LLM API（GPT-4o-mini，用于Claim抽取和结构化推理） ──────────
# 注意：使用你的实际 OpenAI 或兼容 API 密钥
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# ── Bocha Web Search API（证据检索） ────────────────────────
# 申请地址：https://open.bochaai.com
BOCHA_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search
BOCHA_RESULT_COUNT=5
BOCHA_FRESHNESS=noLimit
BOCHA_USE_AUTHORITY=true
BOCHA_AUTHORITY_TIER=all_authority

# ── 本地模型路径 ─────────────────────────────────────────────
# CLIP ViT-L/14 权重（不设则自动下载到 ~/.cache/clip/）
# CLIP_MODEL_PATH=ViT-L/14

# SBERT all-mpnet-base-v2（不设则自动从 HuggingFace 下载）
# SBERT_MODEL_PATH=sentence-transformers/all-mpnet-base-v2

# 本地 Qwen3.5-4B 接口（可选，备用文本生成）
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1/chat/completions
# LOCAL_LLM_API_KEY=ollama
# LOCAL_LLM_MODEL=qwen3:4b
